generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── ENUMS & TYPES ──────────────────────────────────────────────────────────
enum Role {
  CUSTOMER
  PROVIDER
}

enum KycStatus {
  UNVERIFIED
  PENDING
  VERIFIED
}

enum GovDocumentType {
  GHANA_CARD
  VOTERS_ID
}

enum ListingStatus {
  DRAFT
  PUBLISHED
}

// ─── CORE USER ─────────────────────────────────────────────────────────────
model User {
  id               String   @id // Managed explicitly via secure backend UUID mapping
  name             String?
  email            String   @unique
  password         String?  // Handled via secure server-side cryptographic hashing
  avatarUrl        String?  
  isVerified       Boolean  @default(false)
  role             Role     @default(CUSTOMER)
  
  stripeCustomerId String?  
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  providerProfile  ProviderProfile?
  eventListings    EventListing[]
  ticketOrders     TicketOrder[]
  notifications    Notification[]
  savedEvents      SavedEvent[]
  reviews          Review[]
}

// ─── PROVIDER PROFILE ──────────────────────────────────────────────────────
model ProviderProfile {
  id               String          @id @default(uuid())
  userId           String          @unique
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  businessName     String
  description      String?         @db.Text
  logoUrl          String?
  coverPhotoUrl    String?
  verificationTier String          @default("Standard") 
  
  locations        Json?
  operationalHours String?
  teamRoles        Json?
  
  // KYC & Government Identity Fields
  kycStatus        KycStatus       @default(UNVERIFIED)
  legalFullName    String?
  contactEmail     String?         
  contactPhone     String?         
  documentType     GovDocumentType?
  documentNumber   String?         
  
  // Fintech / Paystack Settlement Routing Coordinates
  payoutAccountId        String?
  momoNumber             String?
  bankCode               String?         // Stores routing target (e.g., "MTN", "VOD", "GCB")
  accountNameRaw         String?         // Exact legal string returned by Paystack Resolve API
  paystackSubaccountCode String?         // Unique identifier tracking code generated by Paystack (e.g., ACCT_xxxxxxx)
  
  notificationPrefs Json?
  twoFactorEnabled  Boolean         @default(true)
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ─── EVENTS / LISTINGS ──────────────────────────────────────────────────────
model EventListing {
  id              String        @id @default(uuid())
  providerId      String
  provider        User          @relation(fields: [providerId], references: [id], onDelete: Cascade)
  host            String?
  title           String
  status          ListingStatus @default(DRAFT) 
  statusBadge     String        @default("Available") 
  
  coverImage      String?
  gallery         String[] 
  description     String        @db.Text
  
  startDate       DateTime
  endDate         DateTime?
  startTime       String   
  endTime         String   
  
  venueName       String
  address         String
  city            String   
  latitude        Float?
  longitude       Float?
  
  category        String   // Powers core categorization (Events, Hospitality, Dining, Beauty)
  tags            String[] 
  
  ussdCode        String?       @unique 
  
  totalCapacity   Int           @default(0)
  ticketsSold     Int           @default(0)
  rating          Float         @default(0.0)
  priceIndicator  String        @default("$$") 

  customField1    String?
  customField2    String?  

  // ─── 🧠 SAAS OWNER ADMIN TOGGLES ───────────────────────────────────────
  isHero          Boolean       @default(false)
  isFeatured      Boolean       @default(false)
  isPopular       Boolean       @default(false)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  ticketTiers     TicketTier[]
  lineup          Artist[]
  ticketOrders    TicketOrder[]
  savedByUsers    SavedEvent[]
  reviews         Review[]
  editLogs        EventEditLog[] // 👈 Audit tracking relation for post-sale edits

  // ─── 🚀 DATABASE PERFORMANCE INDEXES ──────────────────────────────────
  @@index([status, startDate])
  @@index([category])
  @@index([city])
  @@index([providerId])
}

// ─── TICKET TIERS ──────────────────────────────────────────────────────────
model TicketTier {
  id              String       @id @default(uuid())
  eventId         String
  event           EventListing @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  name            String       
  description     String?
  price           Float        
  capacity        Int?
  sold            Int          @default(0) // ⚡ Track capacity decrements atomically via webhook pipeline
  isFree          Boolean      @default(false)
  isHidden        Boolean      @default(false) // 👈 Toggles hiding tiers (e.g. expired Early Bird)

  @@index([eventId])
}

// ─── AUDIT LOGGING FOR POST-SALE EDITS ───────────────────────────────────────
model EventEditLog {
  id           String       @id @default(uuid())
  eventId      String
  event        EventListing @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  updatedBy    String       // User/Organizer ID who initiated the change
  fieldChanged String       // e.g. "VENUE", "START_DATE", "START_TIME"
  oldValue     String?      @db.Text
  newValue     String?      @db.Text
  
  createdAt    DateTime     @default(now())

  @@index([eventId])
}

// ─── EVENT LINEUP ──────────────────────────────────────────────────────────
model Artist {
  id              String       @id @default(uuid())
  eventId         String
  event           EventListing @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  name            String       
  role            String?
  imageUrl        String?

  @@index([eventId])
}

// ─── TICKET ORDERS ──────────────────────────────────────────────────────────
model TicketOrder {
  id              String       @id @default(uuid())
  eventId         String
  event           EventListing @relation(fields: [eventId], references: [id], onDelete: Restrict)
  
  customerId      String
  customer        User         @relation(fields: [customerId], references: [id])
  
  ticketTierName  String   
  quantity        Int          @default(1)
  checkedIn       Int          @default(0) // Track how many of the group checked in
  totalAmount     Float    
  currency        String       @default("GHS")
  
  // Real-time Immutable Split Records
  platformFee     Float?       // Stores the exact 7% system cut
  providerPayout  Float?       // Stores the remaining 93% clean payout factor
  
  paymentProvider String       @default("MoMo") 
  transactionId   String?      @unique
  manualCode      String       @unique 
  
  status          String       @default("Pending") 
  checkInStatus   String       @default("Not Arrived") 
  
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([eventId])
  @@index([customerId])
}

// ─── REVIEWS ───────────────────────────────────────────────────────────────
model Review {
  id              String       @id @default(uuid())
  eventId         String
  event           EventListing @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  rating          Float   
  comment         String?      @db.Text
  
  createdAt       DateTime     @default(now())

  @@index([eventId])
}

// ─── SAVED EVENTS ──────────────────────────────────────────────────────────
model SavedEvent {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId   String
  event     EventListing @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  createdAt DateTime     @default(now())

  @@unique([userId, eventId]) 
}

// ─── NOTIFICATIONS ─────────────────────────────────────────────────────────
model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  message   String   
  type      String   
  isRead    Boolean  @default(false)
  
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─── LEGAL DOCUMENTS MODEL ──────────────────────────────────────────────────
model LegalDocument {
  id        String   @id @default(uuid())
  slug      String   @unique // e.g., "terms-of-use", "privacy-policy"
  title     String   // e.g., "vxTicket Terms of Use"
  content   String   @db.Text // Holds the entire policy text
  version   String   @default("1.0.0")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── ⚡ HIGH-VOLUME IDEMPOTENCY MATRIX ──────────────────────────────────────
model WebhookLog {
  id        String   @id // Formatted as "webhook:reference_string"
  createdAt DateTime @default(now())
}